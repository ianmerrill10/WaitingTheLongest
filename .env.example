# ==============================================================================
# Waiting The Longest™ - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ==============================================================================

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME="Waiting The Longest™"
APP_TAGLINE="Because Every Day Matters"
DEBUG=false

# SECURITY - CHANGE THESE!
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING

# ==============================================================================
# DATABASE
# ==============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://waiting_user:CHANGE_PASSWORD@localhost:5432/waiting_the_longest

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD

# ==============================================================================
# DATA SOURCE APIs
# ==============================================================================

# RescueGroups.org (PRIMARY - Petfinder has NO API!)
# Register at: https://rescuegroups.org/services/adoptable-pet-data-api/
RESCUEGROUPS_API_KEY=your_rescuegroups_api_key_here

# Adopt-a-Pet (SECONDARY)
# Apply at: https://www.adoptapet.com/public/apis/pet_list.html
ADOPTAPET_API_KEY=your_adoptapet_api_key_here

# ==============================================================================
# MONETIZATION - AMAZON ASSOCIATES
# ==============================================================================
# Your Associate ID (already registered!)
AMAZON_ASSOCIATE_ID=waitingthelon-20

# For Product Advertising API (optional, after 3 sales)
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key

# ==============================================================================
# EMAIL MARKETING CONFIGURATION
# ==============================================================================
# Email service provider: sendgrid, mailgun, or ses
EMAIL_PROVIDER=sendgrid

# Email provider API key
EMAIL_API_KEY=your_email_api_key_here

# Sender information
EMAIL_FROM_ADDRESS=hello@waitingthelongest.com
EMAIL_FROM_NAME="Waiting The Longest™"

# CAN-SPAM required physical mailing address
EMAIL_MAILING_ADDRESS="Waiting The Longest, 123 Pet Lane, Austin, TX 78701"

# Email tracking settings
EMAIL_TRACKING_ENABLED=true
EMAIL_OPEN_TRACKING=true
EMAIL_CLICK_TRACKING=true

# Newsletter schedule
NEWSLETTER_DAY=sunday
NEWSLETTER_TIME=10:00

# ==============================================================================
# SOCIAL MEDIA APIs
# ==============================================================================

# TikTok Content Posting API
# Apply at: https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Instagram Graph API
# Setup: https://developers.facebook.com/docs/instagram-api/
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Facebook Page Token
FACEBOOK_PAGE_TOKEN=your_facebook_page_token

# Ayrshare (Unified Social Posting - Optional)
# https://www.ayrshare.com/
AYRSHARE_API_KEY=your_ayrshare_api_key

# ==============================================================================
# CORS SETTINGS
# ==============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://waitingthelongest.com,https://www.waitingthelongest.com

# ==============================================================================
# FILE STORAGE PATHS
# ==============================================================================
VIDEO_OUTPUT_DIR=/opt/waitingthelongest/data/videos
IMAGE_CACHE_DIR=/opt/waitingthelongest/data/images
UPLOAD_DIR=/opt/waitingthelongest/data/uploads

# ==============================================================================
# INGESTION SETTINGS
# ==============================================================================
INGEST_ENABLED=true
INGEST_PAGE_LIMIT=50
INGEST_INTERVAL_HOURS=6

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
