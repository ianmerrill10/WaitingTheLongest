# ==============================================================================
# Waiting The Longest™ - Systemd Service Configuration
# ==============================================================================
# Location: /etc/systemd/system/waitingthelongest.service
#
# Commands:
#   systemctl start waitingthelongest
#   systemctl stop waitingthelongest
#   systemctl restart waitingthelongest
#   systemctl status waitingthelongest
#   journalctl -u waitingthelongest -f
# ==============================================================================

[Unit]
Description=Waiting The Longest™ API - Pet Adoption Platform
Documentation=https://github.com/ianmerrill10/WaitedTheLongest
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=waitingapp
Group=waitingapp
WorkingDirectory=/opt/waitingthelongest/backend

# Environment
Environment="PATH=/opt/waitingthelongest/backend/venv/bin"
Environment="PYTHONPATH=/opt/waitingthelongest/backend"
EnvironmentFile=/opt/waitingthelongest/backend/.env

# Start command
ExecStart=/opt/waitingthelongest/backend/venv/bin/gunicorn app.main:app \
    --workers 4 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile /var/log/waitingthelongest/access.log \
    --error-logfile /var/log/waitingthelongest/error.log \
    --log-level info \
    --capture-output

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Directories
ReadWritePaths=/opt/waitingthelongest /var/log/waitingthelongest

# Resource limits
MemoryMax=1G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
