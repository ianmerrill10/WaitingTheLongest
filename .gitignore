# ==============================================================================
# Waiting The Longest™ - Git Ignore
# ==============================================================================

# Environment files (NEVER commit secrets!)
.env
.env.local
.env.production
*.credentials

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
.eggs/
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Project logs folder is tracked (keep artifacts committed)
!logs/README.md
!logs/WORK_COMPLETED.md
!logs/PROBLEMS_SOLVED.md
!logs/KNOWN_ISSUES.md
!logs/CHANGELOG.md
!logs/TESTING_LOG.md
!logs/FILES_TESTED.md
!logs/FILES_TESTED.json

# Data files (generated)
data/videos/
data/images/
data/uploads/

# Node (if any frontend build tools)
node_modules/
npm-debug.log

# Database
*.db
*.sqlite

# Testing
.tox/
.nox/

# Documentation builds
docs/_build/

# Secrets and certificates
*.pem
*.key
*.crt
secrets/

# AWS exports (sanitized metadata snapshots)
aws_exports/
.vercel
